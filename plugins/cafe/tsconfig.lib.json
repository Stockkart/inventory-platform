{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@inventory-platform/api": ["../../shared/api/src/index.ts"],
      "@inventory-platform/product/api": [
        "../../core/product/src/api/index.ts"
      ],
      "@inventory-platform/product/pages/product-search.module.css": [
        "../../core/product/src/pages/product-search.module.css"
      ],
      "@inventory-platform/product/pages/scan-sell.module.css": [
        "../../core/product/src/pages/scan-sell.module.css"
      ],
      "@inventory-platform/routing": ["../../platform/routing/src/index.ts"],
      "@inventory-platform/store": ["../../shared/store/src/index.ts"],
      "@inventory-platform/types": ["../../shared/types/src/index.ts"],
      "@inventory-platform/ui": ["../../shared/ui/src/index.ts"],
      "@inventory-platform/user/customers": [
        "../../core/user/src/api/customers.api.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../core/product/tsconfig.lib.json"
    },
    {
      "path": "../../platform/routing/tsconfig.lib.json"
    },
    {
      "path": "../../shared/store/tsconfig.lib.json"
    },
    {
      "path": "../../shared/ui/tsconfig.lib.json"
    },
    {
      "path": "../../shared/types/tsconfig.lib.json"
    },
    {
      "path": "../../core/user/tsconfig.lib.json"
    },
    {
      "path": "../../shared/api/tsconfig.lib.json"
    }
  ]
}
