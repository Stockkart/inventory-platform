{
  "name": "@inventory-platform/pricing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@inventory-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./routes/*": {
      "@inventory-platform/source": "./src/routes/*.tsx",
      "import": "./src/routes/*.tsx",
      "default": "./src/routes/*.tsx"
    },
    "./api": {
      "@inventory-platform/source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    }
  },
  "nx": {
    "tags": ["type:core", "scope:pricing"]
  },
  "dependencies": {
    "@inventory-platform/api": "workspace:*",
    "@inventory-platform/api-client": "workspace:*",
    "@inventory-platform/product": "workspace:*",
    "@inventory-platform/query": "workspace:*",
    "@inventory-platform/routing": "workspace:*",
    "@inventory-platform/store": "workspace:*",
    "@inventory-platform/types": "workspace:*",
    "@inventory-platform/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  }
}
