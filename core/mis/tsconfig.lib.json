{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@inventory-platform/api-client": ["../../platform/api-client/src/index.ts"],
      "@inventory-platform/query": ["../../platform/query/src/index.ts"],
      "@inventory-platform/routing": ["../../platform/routing/src/index.ts"],
      "@inventory-platform/session": ["../../platform/session/src/index.ts"],
      "@inventory-platform/ui-kit": ["../../ui-kit/src/index.ts"],
      "@inventory-platform/contracts": ["../../platform/contracts/src/index.ts"],
      "@inventory-platform/access": ["../../platform/access/src/index.ts"],
      "@inventory-platform/mis/types": ["./src/model/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.spec.tsx", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "../../platform/query/tsconfig.lib.json"
    },
    {
      "path": "../../platform/api-client/tsconfig.lib.json"
    },
    {
      "path": "../../platform/routing/tsconfig.lib.json"
    },
    {
      "path": "../../platform/session/tsconfig.lib.json"
    },
    {
      "path": "../../ui-kit/tsconfig.lib.json"
    },
    {
      "path": "../../platform/contracts/tsconfig.lib.json"
    }
  ]
}
