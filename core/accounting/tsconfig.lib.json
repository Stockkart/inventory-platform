{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@inventory-platform/query": ["../../platform/query/src/index.ts"],
      "@inventory-platform/routing": ["../../platform/routing/src/index.ts"],
      "@inventory-platform/types": ["../../shared/types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../shared/types/tsconfig.lib.json"
    },
    {
      "path": "../../platform/query/tsconfig.lib.json"
    }
  ]
}
