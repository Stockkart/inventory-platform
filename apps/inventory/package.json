{
  "name": "@inventory-platform/inventory",
  "private": true,
  "type": "module",
  "scripts": {},
  "sideEffects": false,
  "dependencies": {
    "@inventory-platform/plugin-registry": "workspace:*",
    "@inventory-platform/query": "workspace:*",
    "@inventory-platform/shell": "workspace:*",
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "@tanstack/react-query": "^5.90.12",
    "isbot": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:inventory"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "@react-router/dev"
            ]
          },
          {
            "env": "VITE_API_URL"
          },
          {
            "env": "VITE_MOBILE_API_URL"
          },
          {
            "env": "VITE_GOOGLE_CLIENT_ID"
          },
          {
            "env": "VITE_FACEBOOK_APP_ID"
          },
          {
            "env": "VITE_RAZORPAY_KEY_ID"
          },
          {
            "env": "VITE_BUILD_SHA"
          }
        ]
      }
    }
  }
}
