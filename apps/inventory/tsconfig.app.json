        "../../core/user/src/api/vendors.api.ts"
      ],
      "@inventory-platform/user/shop-access": [
        "../../core/user/src/api/shop-access.api.ts"
      ],
      "@inventory-platform/user/invitations": [
        "../../core/user/src/api/invitations.api.ts"
      ],
      "@inventory-platform/user/shops": [
        "../../core/user/src/api/shops.api.ts"
      ],
      "@inventory-platform/user/users": [
        "../../core/user/src/api/user-lookup.api.ts"
      ],
      "@inventory-platform/user/ui": [
        "../../core/user/src/ui/index.ts"
