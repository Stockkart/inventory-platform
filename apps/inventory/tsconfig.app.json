{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ES2019"],
    "types": ["@react-router/node", "vite/client", "node"],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "app",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@inventory-platform/ui": ["../../shared/ui/src/index.ts"],
      "@inventory-platform/store": ["../../shared/store/src/index.ts"],
      "@inventory-platform/api": ["../../shared/api/src/index.ts"],
      "@inventory-platform/types": ["../../shared/types/src/index.ts"],
      "@inventory-platform/payment": ["../../shared/payment/src/index.ts"],
      "@inventory-platform/dashboard": [
        "../../features/dashboard/src/index.ts"
      ],
      "@inventory-platform/onboarding": [
        "../../features/onboarding/src/index.ts"
      ],
      "@inventory-platform/auth": ["../../features/auth/src/index.ts"],
      "@inventory-platform/analytics": ["../../features/analytics/src/index.ts"],
      "@inventory-platform/accounting": ["../../core/accounting/src/index.ts"],
      "@inventory-platform/accounting/routes/*": ["../../core/accounting/src/routes/*"],
      "@inventory-platform/query": ["../../platform/query/src/index.ts"],
      "@inventory-platform/session": ["../../platform/session/src/index.ts"],
      "@inventory-platform/api-client": ["../../platform/api-client/src/index.ts"],
      "@inventory-platform/routing": ["../../platform/routing/src/index.ts"],
      "@inventory-platform/api/customers": ["../../shared/api/src/lib/customers.ts"],
      "@inventory-platform/api/vendors": ["../../shared/api/src/lib/vendors.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "tests/**/*.spec.js",
    "tests/**/*.test.js",
    "tests/**/*.spec.jsx",
    "tests/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../shared/store/tsconfig.lib.json"
    },
    {
      "path": "../../features/onboarding/tsconfig.lib.json"
    },
    {
      "path": "../../shared/types/tsconfig.lib.json"
    },
    {
      "path": "../../shared/api/tsconfig.lib.json"
    },
    {
      "path": "../../features/auth/tsconfig.lib.json"
    },
    {
      "path": "../../features/dashboard/tsconfig.lib.json"
    },
    {
      "path": "../../shared/ui/tsconfig.lib.json"
    },
    {
      "path": "../../platform/query/tsconfig.lib.json"
    },
    {
      "path": "../../core/accounting/tsconfig.lib.json"
    }
  ]
}
