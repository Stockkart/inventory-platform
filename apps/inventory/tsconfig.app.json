  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "tests/**/*.spec.js",
    "tests/**/*.test.js",
    "tests/**/*.spec.jsx",
    "tests/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../core/plan/tsconfig.lib.json"
    },
    {
      "path": "../../core/user/tsconfig.lib.json"
    },
    {
      "path": "../../plugins/registry/tsconfig.lib.json"
    },
    {
      "path": "../../platform/shell/tsconfig.lib.json"
    },
    {
      "path": "../../platform/routing/tsconfig.lib.json"
    },
    {
      "path": "../../platform/session/tsconfig.lib.json"
    },
    {
      "path": "../../platform/query/tsconfig.lib.json"
    },
    {
      "path": "../../ui-kit/tsconfig.lib.json"
    }
  ]
