{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native", "@inventory-platform/source"],
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@inventory-platform/attendance-protocol": [
        "../../platform/attendance-protocol/src/index.ts"
      ],
      "@inventory-platform/contracts": ["../../platform/contracts/src/index.ts"]
    }
  },
  "include": [
    "index.ts",
    "App.tsx",
    "expo-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "dist",
    ".expo",
    "android",
    "ios"
  ],
  "references": [
    {
      "path": "../../platform/attendance-protocol/tsconfig.lib.json"
    },
    {
      "path": "../../platform/contracts/tsconfig.lib.json"
    }
  ]
}
