# Expo / Metro caches
.expo/
web-build/

# Native projects are generated by `expo prebuild` (continuous native generation); the hand-written
# native code lives in modules/biometric-signer/{android,ios}.
/android/
/ios/

# Signing material: never committed
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
google-play-service-account.json

# Local env (EXPO_PUBLIC_API_URL); copy from .env-example
.env
.env.local
