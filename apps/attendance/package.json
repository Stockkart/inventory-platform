{
  "name": "@inventory-platform/attendance",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor",
    "eas:preview": "eas build --profile preview --platform android",
    "eas:production": "eas build --profile production --platform android"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:attendance"
    ],
    "targets": {
      "prebuild:android": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "options": {
          "cwd": "apps/attendance",
          "parallel": false,
          "commands": [
            "expo prebuild --platform android --no-install",
            "cd android && ./gradlew assembleDebug"
          ]
        }
      },
      "prebuild:ios": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "options": {
          "cwd": "apps/attendance",
          "parallel": false,
          "commands": [
            "expo prebuild --platform ios --no-install",
            "pod install --project-directory=ios",
            "xcodebuild -workspace ios/StockKartAttendance.xcworkspace -scheme StockKartAttendance -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
          ]
        }
      }
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  },
  "dependencies": {
    "@inventory-platform/attendance-protocol": "workspace:*",
    "@inventory-platform/contracts": "workspace:*",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~55.0.32",
    "expo-background-task": "~55.0.22",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-location": "~55.1.15",
    "expo-secure-store": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "55.0.25",
    "typescript": "~5.9.2"
  }
}
