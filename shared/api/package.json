{
  "name": "@inventory-platform/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@inventory-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./customers": {
      "@inventory-platform/source": "./src/lib/customers.ts",
      "import": "./src/lib/customers.ts",
      "default": "./src/lib/customers.ts"
    },
    "./vendors": {
      "@inventory-platform/source": "./src/lib/vendors.ts",
      "import": "./src/lib/vendors.ts",
      "default": "./src/lib/vendors.ts"
    }
  },
  "dependencies": {
    "@inventory-platform/api-client": "workspace:*",
    "axios": "^1.13.2",
    "tslib": "^2.3.0"
  },
  "nx": {
    "tags": ["type:legacy"]
  }
}
