{
  "name": "@inventory-platform/shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@inventory-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "@inventory-platform/source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./types": {
      "@inventory-platform/source": "./src/model/index.ts",
      "types": "./dist/model/index.d.ts",
      "import": "./src/model/index.ts",
      "default": "./src/model/index.ts"
    }
  },
  "nx": {
    "tags": [
      "type:platform",
      "scope:shell"
    ]
  },
  "dependencies": {
    "@inventory-platform/ui-kit": "workspace:*",
    "@inventory-platform/access": "workspace:*",
    "@inventory-platform/api-client": "workspace:*",
    "@inventory-platform/routing": "workspace:*",
    "@inventory-platform/session": "workspace:*",
    "@inventory-platform/user": "workspace:*",
    "lucide-react": "^0.554.0",
    "@inventory-platform/contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  }
}
