{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@inventory-platform/api": ["../../shared/api/src/index.ts"],
      "@inventory-platform/api-client": [
        "../../platform/api-client/src/index.ts"
      ],
      "@inventory-platform/types": ["../../shared/types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../../shared/types/tsconfig.lib.json"
    },
    {
      "path": "../api-client/tsconfig.lib.json"
    },
    {
      "path": "../../shared/api/tsconfig.lib.json"
    }
  ]
}
